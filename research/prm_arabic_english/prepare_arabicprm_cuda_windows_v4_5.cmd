@echo off
setlocal EnableExtensions DisableDelayedExpansion
title ArabicPRM CUDA installation readiness - dry-run only
echo Checking a new isolated CUDA environment plan. Zero package downloads or installs.
echo Existing environments, models and checkouts stay untouched. Installation requires separate approval.
set "ARABICPRM_CUDA_SETUP_SELF=%~f0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $temp=$null; try { $encoded=@(Get-Content -LiteralPath $env:ARABICPRM_CUDA_SETUP_SELF | ForEach-Object { if($_ -match '^rem ARABICPRM-CUDA-SETUP-PAYLOAD ([A-Za-z0-9+/=]+)$'){$Matches[1]} }) -join ''; $bytes=[Convert]::FromBase64String($encoded); $hash=[Security.Cryptography.SHA256]::Create(); try { $actual=[BitConverter]::ToString($hash.ComputeHash($bytes)).Replace('-','').ToLowerInvariant() } finally { $hash.Dispose() }; if($actual -ne '4ab5aa3700ce6d00bece99a96d30612b1ef930365d44230955345c6bb52581eb'){throw 'CUDA setup helper SHA256 mismatch; nothing executed.'}; if($env:ARABICPRM_CUDA_SETUP_VERIFY_ONLY -eq '1'){Write-Host 'CUDA SETUP HELPER VERIFIED: exact bytes; nothing executed.'; exit 0}; $paths=@(Get-Command python.exe -All -CommandType Application -ErrorAction SilentlyContinue | ForEach-Object {$_.Source}); $py=Get-Command py.exe -CommandType Application -ErrorAction SilentlyContinue; if($py -and $py.Source -notmatch '\\WindowsApps\\'){try {$paths+=@(& $py.Source -0p 2>$null | ForEach-Object {if($_ -match '(?i)([A-Z]:\\.+?python\.exe)\s*$'){$Matches[1]}})} catch {}}; $paths+=Join-Path $env:LOCALAPPDATA 'Programs\Python\Python311\python.exe'; $chosen=$null; foreach($p in ($paths | Select-Object -Unique)){if($p -and $p -notmatch '\\WindowsApps\\' -and (Test-Path -LiteralPath $p -PathType Leaf)){ & $p -I -S -B -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)'; if($LASTEXITCODE -eq 0){$chosen=$p; break} }}; if(-not $chosen){throw 'No installed Python 3.11+ executable was found. Nothing was installed.'}; $temp=Join-Path $env:TEMP ('ArabicPRM-clean-'+[guid]::NewGuid().ToString('N')+'.py'); [IO.File]::WriteAllBytes($temp,$bytes); & $chosen -I -S -B $temp; exit $LASTEXITCODE } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 } finally { if($temp -and (Test-Path -LiteralPath $temp)){Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue} }"
set "ARABICPRM_CUDA_SETUP_EXIT=%ERRORLEVEL%"
if "%ARABICPRM_CUDA_SETUP_VERIFY_ONLY%"=="1" goto done
if /i "%GITHUB_ACTIONS%"=="true" goto done
echo.
echo Upload only share_status.json. Keep report_private.json and pending request local.
pause
:done
endlocal & exit /b %ARABICPRM_CUDA_SETUP_EXIT%
