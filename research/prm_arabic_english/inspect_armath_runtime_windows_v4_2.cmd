xit $LASTEXITCODE } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 } finally { if($temp -and (Test-Path -LiteralPath $temp)){Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue} }"
set "ARABICPRM_ARMATH_INSPECT_EXIT=%ERRORLEVEL%"
if "%ARABICPRM_ARMATH_INSPECT_VERIFY_ONLY%"=="1" goto done
if /i "%GITHUB_ACTIONS%"=="true" goto done
echo.
echo Share only share_status.json. Keep report_private.json private.
pause
:done
