if "%ARABICPRM_ARMATH_INSPECT_VERIFY_ONLY%"=="1" goto done
if /i "%GITHUB_ACTIONS%"=="true" goto done
echo.
echo Share only share_status.json. Keep report_private.json private.
pause
:done
