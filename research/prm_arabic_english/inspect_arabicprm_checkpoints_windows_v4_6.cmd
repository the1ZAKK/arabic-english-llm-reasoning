@echo off
setlocal EnableExtensions DisableDelayedExpansion
title ArabicPRM checkpoint metadata compatibility - no model operations
echo Inspecting retained checkpoint ZIP metadata and exact byte hashes. No tensors are loaded.
echo The original checkout and backup stay untouched. No inference or budget activation.
set "ARABICPRM_CHECKPOINT_COMPAT_SELF=%~f0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $temp=$null; try { $encoded=@(Get-Content -LiteralPath $env:ARABICPRM_CHECKPOINT_COMPAT_SELF | ForEach-Object { if($_ -match '^rem ARABICPRM-CHECKPOINT-COMPAT-PAYLOAD ([A-Za-z0-9+/=]+)$'){$Matches[1]} }) -join ''; $bytes=[Convert]::FromBase64String($encoded); $hash=[Security.Cryptography.SHA256]::Create(); try { $actual=[BitConverter]::ToString($hash.ComputeHash($bytes)).Replace('-','').ToLowerInvariant() } finally { $hash.Dispose() }; if($actual -ne '030320443976bab219c97fc5e4636bce8e7c3494c069f1a447e7766c23c4cd65'){throw 'Checkpoint compatibility payload SHA256 mismatch; nothing executed.'}; if($env:ARABICPRM_CHECKPOINT_COMPAT_VERIFY_ONLY -eq '1'){Write-Host 'CHECKPOINT COMPAT HELPER VERIFIED: exact bytes; nothing executed.'; exit 0}; if(-not $env:ARABICPRM_CHECKPOINT_INVENTORY){if($env:GITHUB_ACTIONS -eq 'true'){throw 'Existing private inventory path required; no scan was started.'}; Add-Type -AssemblyName System.Windows.Forms; $dialog=New-Object System.Windows.Forms.OpenFileDialog; try {$dialog.Title='Select the existing v4.3 report_private.json (keep it private)'; $dialog.Filter='Private JSON report (*.json)|*.json'; $dialog.CheckFileExists=$true; if($dialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK){Write-Host 'CANCELLED: zero model operations; no checkpoint inspection started.'; exit 0}; $env:ARABICPRM_CHECKPOINT_INVENTORY=$dialog.FileName} finally {$dialog.Dispose()}}; $paths=@(Get-Command python.exe -All -CommandType Application -ErrorAction SilentlyContinue | ForEach-Object {$_.Source}); $py=Get-Command py.exe -CommandType Application -ErrorAction SilentlyContinue; if($py -and $py.Source -notmatch '\\WindowsApps\\'){try {$paths+=@(& $py.Source -0p 2>$null | ForEach-Object {if($_ -match '(?i)([A-Z]:\\.+?python\.exe)\s*$'){$Matches[1]}})} catch {}}; $paths+=Join-Path $env:LOCALAPPDATA 'Programs\Python\Python311\python.exe'; $chosen=$null; foreach($p in ($paths | Select-Object -Unique)){if($p -and $p -notmatch '\\WindowsApps\\' -and (Test-Path -LiteralPath $p -PathType Leaf)){ & $p -I -S -B -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)'; if($LASTEXITCODE -eq 0){$chosen=$p; break} }}; if(-not $chosen){throw 'No installed Python 3.11+ executable was found. Nothing was installed.'}; $temp=Join-Path $env:TEMP ('ArabicPRM-checkpoint-compat-'+[guid]::NewGuid().ToString('N')+'.pyz'); [IO.File]::WriteAllBytes($temp,$bytes); & $chosen -I -S -B $temp; exit $LASTEXITCODE } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 } finally { if($temp -and (Test-Path -LiteralPath $temp)){Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue} }"
set "ARABICPRM_CHECKPOINT_COMPAT_EXIT=%ERRORLEVEL%"
if "%ARABICPRM_CHECKPOINT_COMPAT_VERIFY_ONLY%"=="1" goto done
if /i "%GITHUB_ACTIONS%"=="true" goto done
echo.
echo Upload only the NEW share_status.json. Keep inventories and report_private.json local.
pause
:done
endlocal & exit /b %ARABICPRM_CHECKPOINT_COMPAT_EXIT%
